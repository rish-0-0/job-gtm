# Helper System Configuration
# Copy this file to .env and update the values

# =============================================================================
# REQUIRED: RabbitMQ URL on the main laptop
# =============================================================================
# Replace 192.168.1.XXX with your main laptop's IP address
# To find your IP:
#   Windows: ipconfig (look for IPv4 Address)
#   Linux/Mac: ip addr or ifconfig
#
RABBITMQ_URL=amqp://jobgtm:jobgtm_password@192.168.1.XXX:5672/

# =============================================================================
# OPTIONAL: Performance tuning
# =============================================================================

# Number of consumer instances to run (default: 1)
# Increase if you have a powerful GPU
CONSUMER_REPLICAS=1

# Number of jobs to process per batch (default: 20)
ENRICHMENT_BATCH_SIZE=20

# Max concurrent Ollama API calls (default: 8)
# This should match OLLAMA_NUM_PARALLEL
OLLAMA_RATE_LIMIT=8

# Ollama parallel request handling (default: 8)
# How many requests Ollama can process simultaneously
# With 16GB VRAM and 3B model, 8 is safe (uses ~10GB VRAM)
# Reduce to 5 if you see OOM errors
OLLAMA_NUM_PARALLEL=8
